# ── Copy this file to .env and fill in your values ──────────
# .env is gitignored — never commit real credentials.

# Database (leave blank to use SQLite — recommended for local dev)
DB_TYPE=sqlite
SQLITE_PATH=resume_analyzer.db

# Only needed if DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASS=your_password_here
MYSQL_DB=cv

# Admin login for the dashboard
ADMIN_USER=admin
ADMIN_PASS=change_me_please

# Groq API Key (get it from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

